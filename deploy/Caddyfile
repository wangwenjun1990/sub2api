# =============================================================================
# Caddy 配置：落地页（静态）+ sub2api（反向代理）
# 部署前把 queqiaohub.com 换成你的域名
# 说明见 deploy/EDGE_SECURITY.md
# =============================================================================

{
	servers {
		max_header_size 64KB
		timeouts {
			read_header 10s
			idle 2m
		}

		# 可选：只允许 Cloudflare 回源时，用下面三行信任 CF-Connecting-IP 拿真实
		# 客户端 IP。CIDR 需要换成 https://www.cloudflare.com/ips/ 的最新回源段，
		# 并同时取消 api 站点里 header_up 两行的注释。
		# trusted_proxies static 173.245.48.0/20 103.21.244.0/22
		# trusted_proxies_strict
		# client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# -----------------------------------------------------------------------------
# 落地页：/opt/sub2api/landing/index.html
# -----------------------------------------------------------------------------
queqiaohub.com, www.queqiaohub.com {
	root * /opt/sub2api/landing
	encode zstd gzip
	file_server
}

# -----------------------------------------------------------------------------
# sub2api 控制台 + API
# Caddy 装在宿主机上，所以转发到 127.0.0.1:8080
# -----------------------------------------------------------------------------
api.queqiaohub.com {
	# 不要改成 encode gzip zstd 简写：它会把 text/event-stream 也压缩并缓冲，
	# 导致流式响应（SSE）卡住直到结束。
	encode {
		zstd
		gzip 6
		minimum_length 256
		match {
			header Content-Type text/css*
			header Content-Type text/csv*
			header Content-Type text/html*
			header Content-Type text/javascript*
			header Content-Type text/markdown*
			header Content-Type text/plain*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/rss+xml*
			header Content-Type image/svg+xml*
		}
	}

	# 上传/请求体上限，按需调整
	request_body {
		max_size 256MB
	}

	reverse_proxy 127.0.0.1:8080 {
		transport http {
			keepalive 120s
			keepalive_idle_conns 256
			read_buffer 16KB
			write_buffer 16KB
			compression off
		}
	}

	# 可选：配合上面全局 trusted_proxies 使用，向后端传递真实客户端 IP
	# header_up X-Real-IP {client_ip}
	# header_up X-Forwarded-For {client_ip}
}
